# Copy this file to .env and fill in real values before running in anything
# but a quick local test.

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on. The frontend's VITE_API_URL should point here.
PORT=4000

# Comma-free single origin (or "*" for local development). Set this to your
# deployed frontend's URL in production instead of "*".
CORS_ORIGIN=*
