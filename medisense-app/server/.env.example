# MediSense Backend Environment Configuration Template
# Copy to server/.env for local development. Never commit server/.env or real secrets.

# Runtime environment: development | production | test
NODE_ENV=development

# Cryptographic secret used to sign HS256 JWT tokens (REQUIRED, min 32 high-entropy chars in production).
# Generate a secure secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT session lifetime (e.g., 12h, 24h, 7d)
JWT_EXPIRY=24h

# HTTP port the Express server listens on (1-65535)
PORT=4000

# Comma-separated allowed browser origins (e.g., https://medisense.vercel.app).
# Wildcard "*" is strictly forbidden when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI (server-side only — never expose to frontend)
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Clinic provisioning code required for doctor account registration in production (min 8 chars)
DOCTOR_INVITE_CODE=

# Development demo accounts (strictly forbidden when NODE_ENV=production)
ENABLE_DEMO_ACCOUNTS=true

# Live openFDA Drug Labeling lookup fallback when local rules have no match ("true" | "false")
ENABLE_OPENFDA_LOOKUP=true

# Optional: Supabase Storage for persistent cloud medical document uploads
# Defaults to private local disk (server/uploads/) when left blank.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=medisense-documents

# Optional in dev (auto-generated into server/data/vapid.json), required in production for Web Push
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: SMTP configuration for transactional verification & password-reset emails.
# Leave blank in local dev to log dev tokens in server console instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
