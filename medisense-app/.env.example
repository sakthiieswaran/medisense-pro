# MediSense Frontend (Vite) Environment Configuration
# Copy to .env.development for custom local dev overrides, or configure in
# Vercel / hosting platform Project Environment Variables for production.
# SECURITY: NEVER put API keys, JWT secrets, database keys, or service-role keys
# in VITE_* variables — every VITE_* value is bundled into public browser JS.

# Backend API base URL.
# - In local development (npm run dev), defaults to http://localhost:4000 when unset.
# - In production builds (vite build), MUST be set to your deployed backend URL
#   (e.g., https://api.your-medisense-domain.com) unless served via same-origin proxy.
VITE_API_URL=http://localhost:4000
